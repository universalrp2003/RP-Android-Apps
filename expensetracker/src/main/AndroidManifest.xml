<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      B2 - the whole permission surface of this app.

      SMS and Internet access are narrowly separated: SMS messages and the local ledger are never
      uploaded. INTERNET is used only for a once-per-day public release metadata check when the app
      opens. The check sends no SMS, transaction, balance, or ledger content. The website/GitHub may
      receive ordinary request metadata such as the device IP address. This app does not download or
      install APKs; updates open in the user's browser.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
      Deliberately absent:
        - no ACCESS_NETWORK_STATE, location, contacts, storage, camera or phone-state access.
        - no account, analytics or advertising id.
      Transactions are written to this app's private storage and read back from it.
    -->

        <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the ledger current without the app being open.

          exported="true" is required here and is not a hole: SMS_RECEIVED is a protected
          broadcast, and android:permission="android.permission.BROADCAST_SMS" means only the
          system - which holds that permission - can deliver to this receiver. A receiver marked
          exported="false" is silently skipped for this broadcast, which is a live-update path
          that never fires. This is the same declaration SMS Guard uses.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
