<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      B2 - the whole permission surface of this app.

      RECEIVE_SMS and READ_SMS, and nothing else. There is deliberately NO android.permission.INTERNET
      declaration anywhere in this file, which is not an oversight: it is the app's promise. An expense
      tracker that cannot open a socket cannot leak a ledger, and the Android permission screen will
      say so out loud - "No internet access" - the moment the owner looks.

      That is also why there is no voice here. The HD neural voice is a network call, and this app
      does not make network calls.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
      Deliberately absent:
        - no INTERNET / ACCESS_NETWORK_STATE. The ledger never leaves the phone.
        - no location, no contacts, no storage, no camera, no phone state.
        - no account, no analytics, no advertising id.
      Transactions are written to this app's private storage and read back from it.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the ledger current without the app being open. Declared with the default
          (non-exported) visibility, so only the system can deliver to it.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
