<?xml version="1.0" encoding="utf-8"?>
<!--
  Emergency Alert - அவசர எச்சரிக்கை.

  It listens for the sounds that mean somebody needs help and alerts the family, in Tamil.

  The permission set is the smallest one that can do that, and each one is here for a reason
  that is stated rather than implied:

    RECORD_AUDIO                     to hear the room at all.
    SYSTEM_ALERT_WINDOW              not used; declared nowhere. The app has no floating window.
    INTERNET                         for the local-network alert only. The alert is a UDP packet
                                     on the home Wi-Fi, which needs the socket permission but no
                                     internet connection, no server and no account.
    VIBRATE                          so the alert is felt when the phone is in a pocket.
    FOREGROUND_SERVICE               to keep listening while the phone is doing something else.
    FOREGROUND_SERVICE_MICROPHONE    because that service has the microphone open.
    POST_NOTIFICATIONS               Android 13+ asks for this before any notice can be shown.
    RECEIVE_BOOT_COMPLETED           to resume listening after the phone restarts.

  SEND_SMS is deliberately NOT declared. The owner's chosen scope was the local network, and an
  app that can send a text message from a phone is a different risk to a different app. If SMS
  is ever wanted it will be a separate, explicitly granted step.

  No location, no contacts, no storage, no camera, no phone state, no accounts, no advertising id.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Emergency">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The listening service. It is not exported: nothing outside this app may start it, and the
          alert it sends carries no personal data beyond the name of the sound.
        -->
        <service
            android:name=".EmergencyService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          Restarts listening after a reboot, but only if the owner left it on. Without this a
          family finds the guard silently off after the phone restarts, which is the worst failure
          mode something like this can have.
        -->
        <receiver
            android:name=".AlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
