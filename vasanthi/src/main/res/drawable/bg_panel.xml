<?xml version="1.0" encoding="utf-8"?>
<!-- The panel. Dark, because Tamil text that appears for a few seconds and scrolls away is being
     read at a glance, and this pairing survives both a dim room and bright sunlight. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F207220F" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#334ADE80" />
</shape>
