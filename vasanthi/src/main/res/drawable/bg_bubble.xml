<?xml version="1.0" encoding="utf-8"?>
<!-- The always-there bubble. Solid, circular, and ringed so it reads as a control rather than as
     a notification badge, because it has to be findable at a glance over whatever app is open. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#E607220F" />
    <stroke
        android:width="2dp"
        android:color="#FF4ADE80" />
    <size
        android:width="56dp"
        android:height="56dp" />
</shape>
