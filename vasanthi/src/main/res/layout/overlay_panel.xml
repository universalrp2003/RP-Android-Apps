<?xml version="1.0" encoding="utf-8"?>
<!--
  The panel the bubble opens.

  The order of the sections is the design decision, and it is deliberate:

    1. இப்போது - what the room is doing right now, named in Tamil, with how sure the app is.
    2. அறை சத்தம் - how loud the room is, as a bar and a word.
    3. பேச்சு - what someone just said, in Tamil, newest last.

  Speech is last because it is the thing she reads line by line, and the two things above it are
  the things she checks at a glance. Anything that interrupts the transcript is in the way.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: the name, and the two ways out. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FF4ADE80"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/panel_open_app"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/open_full_screen"
            android:padding="8dp"
            android:src="@drawable/ic_open_full" />

        <ImageButton
            android:id="@+id/panel_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/close_panel"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- 1. What the room is doing. -->
    <TextView
        android:id="@+id/panel_now_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/what_is_happening_now"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/panel_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minLines="1"
        android:text="@string/nothing_heard_yet"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/panel_confidence"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/bg_bar_fill" />

    <TextView
        android:id="@+id/panel_confidence_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#66FFFFFF"
        android:textSize="11sp" />

    <!-- 2. How loud the room is. -->
    <TextView
        android:id="@+id/panel_level_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/room_loudness"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/panel_level"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressDrawable="@drawable/bg_bar_fill" />

    <TextView
        android:id="@+id/panel_level_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#66FFFFFF"
        android:textSize="11sp" />

    <!-- 3. What someone said. -->
    <TextView
        android:id="@+id/panel_speech_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/what_was_said"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/panel_speech_scroll"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/panel_speech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nothing_said_yet"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
    </ScrollView>

    <!-- Controls. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/panel_listen"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/start_listening"
            android:textSize="14sp" />

        <Button
            android:id="@+id/panel_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/stop"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#66FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
