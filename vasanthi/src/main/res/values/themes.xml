<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window background is deliberately dark. Someone reading Tamil text that appears for a
         few seconds and then scrolls away is doing so at a glance, and the high-contrast pairing
         survives bright sunlight and a dim room equally well. -->
    <style name="Theme.Vasanthi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
