<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      To list the phone's installed apps, a launcher must be able to see them. On Android 11+ that
      needs the QUERY_ALL_PACKAGES permission, which Google Play restricts to launchers - which is
      exactly what this is. It is declared rather than worked around with <queries>, because a
      launcher that can only see the apps it was told about in advance is not a launcher.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- The torch button and the volume buttons act on the phone directly. -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Reading the contact the owner picks, to put a name and a number on a button. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      A launcher is the home screen, so it has to be the thing that answers the home button.
      CATEGORY_HOME is what makes that happen; CATEGORY_LAUNCHER would make it just another app.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:label="@string/app_name">
            <!--
              Both categories, and both on purpose. HOME is what makes this the home screen.
              LAUNCHER is what makes it appear in every app list on the phone - its own, and the
              one in Settings where an app is uninstalled. Without it the app worked perfectly as
              the home screen and was invisible everywhere else, which is what the owner found: he
              could not find it to open it or to remove it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
