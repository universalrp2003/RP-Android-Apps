    <string name="storage_evidence_title">2. Storage evidence</string>
    <string name="storage_candidate_disk">Candidate block device</string>
    <string name="storage_disk_value">%1$s GB (%2$s GiB), %3$d sectors\n%4$s</string>
    <string name="storage_data_report">Reported /data filesystem</string>
    <string name="storage_data_value">%1$s GiB total · %2$s GiB available</string>
    <string name="storage_used_data">Reported /data used (total − available)</string>
    <string name="storage_system">/system filesystem capacity</string>
    <string name="storage_vendor">/vendor filesystem capacity</string>
    <string name="storage_cache">/cache filesystem capacity</string>
    <string name="storage_estimated_remainder">Rough remainder (not verified free)</string>
    <string name="storage_gib_value">%1$s GiB</string>
    <string name="evidence_unavailable">Unavailable</string>
    <string name="storage_evidence_explanation">GB uses decimal units; GiB uses powers of 1024. A 16 GB chip is about 14.9 GiB before partitions. The rough remainder subtracts reported data use and listed filesystem capacities from the candidate disk size. Other partitions, reserved blocks, shared mounts, a different disk or altered reports can make it wrong. It is not a measurement of writable free space; an independent, non-destructive device check is needed.</string>
    <string name="os_evidence_title">3. Android version evidence</string>
    <string name="os_reported_release">Reported Android release</string>
    <string name="os_framework_marker">Framework class probe</string>
    <string name="os_reported_sdk">Reported SDK API</string>
    <string name="os_kernel">Kernel release</string>
    <string name="os_build_timestamp">Build timestamp (milliseconds)</string>
    <string name="os_evidence_explanation">Android 14 normally reports API 34 or newer and contains the tested Android 14 class. A mismatch suggests an altered or customized system, but the release, SDK and kernel can also be modified. These checks cannot authenticate the exact Android base version.</string>
