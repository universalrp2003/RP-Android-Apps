    <string name="tools_overview_title">Launcher tools and settings</string>
    <string name="launcher_only_active">Launcher only</string>
    <string name="expert_active">Expert controls enabled</string>
    <string name="expert_settings_title">Expert settings</string>
    <string name="expert_settings_subtitle">Choose optional features</string>
    <string name="expert_master_title">Expert mode</string>
    <string name="expert_master_description">Off: launcher only. On: show the individual switches. Turning Expert on again restores saved choices, so a previously enabled file hub may start automatically.</string>
    <string name="expert_intro">Press OK on each switch. Turning a feature off stops its associated work where possible. Memory savings vary by device; no fixed saving is guaranteed.</string>
    <string name="expert_waiting_for_parent">Saved ON, but paused until the required parent switch is ON.</string>
    <string name="feature_on">ON</string>
    <string name="feature_off">OFF</string>
    <string name="feature_status_bar">Top status bar and clock</string>
    <string name="feature_status_bar_desc">Show the top header and clock. The individual status pills below need this switch.</string>
    <string name="feature_cpu_pill">CPU load pill</string>
    <string name="feature_cpu_pill_desc">While visible, sample CPU counters about every 2.5 seconds. Requires the top status bar.</string>
    <string name="feature_ram_pill">RAM pill</string>
    <string name="feature_ram_pill_desc">While visible, sample available memory about every 10 seconds. Requires the top status bar.</string>
    <string name="feature_storage_pill">Storage pill</string>
    <string name="feature_storage_pill_desc">While visible, read reported storage about every 30 seconds. Requires the top status bar.</string>
    <string name="feature_network_pill">Network quality pill</string>
    <string name="feature_network_pill_desc">While visible, periodically probe common internet and router addresses. Requires the top status bar.</string>
    <string name="feature_voice">Voice helper</string>
    <string name="feature_voice_desc">Use speech recognition and basic local TV questions on demand. Microphone permission and an installed recognizer are needed. Hardware answers need Hardware Audit; screenshot and boost commands need their own switches.</string>
    <string name="feature_system_ai">System assistant / AI</string>
    <string name="feature_system_ai_desc">Allow opening an installed Android assistant for broader questions. Its availability and privacy rules depend on that provider; TV Guard does not send it a transcript.</string>
    <string name="feature_screenshot">Screenshots</string>
    <string name="feature_screenshot_desc">Allow on-demand captures. Turning this off does not delete saved screenshots; an enabled file hub can still share them.</string>
    <string name="feature_file_hub">Wi-Fi file hub</string>
    <string name="feature_file_hub_desc">Start the local listener while the TV Guard activity exists. It can expose Downloads and saved screenshots; the warning above applies. It can start again when Expert is restored.</string>
    <string name="feature_web_remote">Browser remote controls</string>
    <string name="feature_web_remote_desc">Allow browser keys, text, app launches and installation prompts. Requires the file hub. Remote screenshot and boost also require their own switches.</string>
    <string name="feature_hardware_audit">Hardware audit</string>
    <string name="feature_hardware_audit_desc">Run hardware and root evidence checks when enabled or refreshed. A root manager may prompt; reported readings cannot authenticate the device.</string>
    <string name="feature_debloater">TV Debloater</string>
    <string name="feature_debloater_desc">Scan packages and check for root only while its screen is open. A root manager may prompt. Review choices before removing anything.</string>
    <string name="feature_network_tools">Network diagnostics</string>
    <string name="feature_network_tools_desc">Probe internet and common router addresses when the diagnostics screen opens or is retested.</string>
    <string name="feature_ram_boost">RAM boost</string>
    <string name="feature_ram_boost_desc">Allow an on-demand attempt to stop background apps and, if root is available, drop kernel caches. Results vary.</string>
    <string name="feature_running_apps">Running apps list</string>
    <string name="feature_running_apps_desc">Scan processes while the Tools overview is open. Android may restrict which processes are visible.</string>
