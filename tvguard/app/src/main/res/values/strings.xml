    <string name="storage_issue_mismatch">Possible storage mismatch: /data reports %1$s GB, while candidate %2$s reports %3$s GB. Check that this disk backs /data; firmware can also affect these readings.</string>
    <string name="os_issue_api">Android %1$s is reported, but the reported SDK is API %2$d. Android %3$d normally requires API %4$d or newer.</string>
    <string name="os_issue_marker">Android %1$s and API %2$d are reported, but the Android 14 framework class probe is unavailable. The framework may be inconsistent or customized.</string>
