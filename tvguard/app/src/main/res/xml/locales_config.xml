<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ shows these in Settings > System > Languages, so the OS can switch the whole
     app between English and Tamil instead of only parts of it. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ta" />
</locale-config>
